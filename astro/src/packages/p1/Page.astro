---
import controlsUrl from "./controls.js?url&no-inline";
import aboutDataUrl from "../../components/about-this-data.js?url&no-inline";
import Layout from "../../layouts/Layout.astro";
import type { LoadedPage } from "./page";
interface Props { page: LoadedPage }
const { page } = Astro.props;
---
<Layout {...page}>
  <Fragment set:html={page.html} />
  {page.interactive && <script is:inline type="module" src={controlsUrl}></script>}
  {page.aboutData && <script is:inline type="module" src={aboutDataUrl}></script>}
</Layout>
