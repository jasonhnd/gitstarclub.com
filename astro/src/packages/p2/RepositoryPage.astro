---
import Layout from "../../layouts/Layout.astro";
import { RepoPageView } from "./repo";
import { repositoryMetadata, type RepositoryPage } from "./data";
import "./styles.css";
interface Props { page: RepositoryPage }
const { page } = Astro.props;
const metadata = repositoryMetadata(page);
---
<Layout locale={page.locale} {...metadata}>
  <RepoPageView {...page} />
</Layout>
<script>
  import "./share";
</script>
