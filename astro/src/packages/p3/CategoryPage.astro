---
import Layout from "../../layouts/Layout.astro";
import Body from "./Body";
import type { loadCategoryPage } from "./load";
type Props = Exclude<Awaited<ReturnType<typeof loadCategoryPage>>, Response>;
const { locale, canonicalPath, title, description, body, asOf } = Astro.props;
---
<Layout locale={locale} canonicalPath={canonicalPath} title={title} description={description} asOf={asOf}>
  <Body content={body} />
</Layout>

<script>
  import "../../components/about-this-data";
</script>

<style is:global>
  /* Keep the original system-ui/ui-monospace fallbacks after the packaged families. */
  :root {
    --font-plus-jakarta: "Plus Jakarta Sans Variable";
    --font-geist-mono: "Geist Mono Variable";
  }
</style>
