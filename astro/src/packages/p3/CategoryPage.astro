---
import Layout from "../../layouts/Layout.astro";
import Body from "./Body";
import type { loadCategoryPage } from "./load";
type Props = Exclude<Awaited<ReturnType<typeof loadCategoryPage>>, Response>;
const { locale, canonicalPath, title, description, body } = Astro.props;
---
<Layout locale={locale} canonicalPath={canonicalPath} title={title} description={description}>
  <Body content={body} />
</Layout>
