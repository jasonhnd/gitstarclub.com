---
import Layout from "../../layouts/Layout.astro";
import { getDictionary, type Locale } from "../../lib/i18n";
import { PulseBody } from "./PulseBody";
import { loadPulse } from "./data";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = await getDictionary(locale);
const now = new Date();
const data = await loadPulse(Astro.locals.data, now);
---
<Layout locale={locale} canonicalPath="/pulse" title={t.meta.pulseTitle} description={t.meta.pulseDescription}>
  <PulseBody locale={locale} t={t} data={data} now={now} />
</Layout>
