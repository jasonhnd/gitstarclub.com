---
import { type Dict, type Locale } from "../../../web/lib/i18n";
import { localizedPath } from "../../../web/lib/i18n/routing";
import { Star } from "../../../web/app/_explore/Star";
import LanguageSwitcher from "./LanguageSwitcher.astro";
interface Props { locale: Locale; canonicalPath: string; dictionary: Dict; asOf?: string | null }
const { locale, canonicalPath, dictionary: t, asOf } = Astro.props;
const links = [["/pulse", t.nav.pulse], ["/rankings", t.nav.rankings], ["/categories", t.nav.categories], ["/o", t.nav.organizations], ["/about", t.nav.about], ["/releases", t.footer.releases], ["/privacy", t.footer.privacy]];
---
<footer class="mt-auto border-t border-outline-variant py-8 px-[clamp(1.25rem,5vw,2.5rem)]">
  <div class="mx-auto flex w-full max-w-[68rem] flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <a href={localizedPath(locale, "/")} class="inline-flex items-center gap-2 font-extrabold tracking-[-0.02em] text-on-surface"><Star />GitStarClub</a>
    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[0.78rem] text-on-surface-variant" aria-label={t.a11y.footer}>
      {links.map(([path, text]) => <a href={localizedPath(locale, path)} class="transition-colors hover:text-on-surface">{text}</a>)}
      <LanguageSwitcher locale={locale} canonicalPath={canonicalPath} label={t.a11y.language} />
    </nav>
  </div>
  <div class="mx-auto mt-4 w-full max-w-[68rem] font-mono text-[0.72rem] text-on-surface-variant">
    {t.footer.madeIn}{asOf ? ` · ${t.footer.dataThrough} ${asOf}` : ""}
    <span class="mt-2 block max-w-[72ch] leading-relaxed">{t.footer.dataFrom}{" "}<a class="text-tertiary hover:text-primary" href="https://www.gharchive.org/" rel="noreferrer">GH Archive</a>, {t.footer.licensedUnder}{" "}<a class="text-tertiary hover:text-primary" href="https://creativecommons.org/licenses/by/4.0/" rel="noreferrer">CC BY 4.0</a>, {t.footer.attributionSuffix}</span>
  </div>
</footer>
