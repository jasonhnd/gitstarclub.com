{
  "name": "gitstarclub-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "bun run build:production",
    "typecheck": "node scripts/prepare-local.mjs && astro check && tsc --noEmit",
    "test": "bun test tests/ --isolate",
    "test:worker": "bun test worker-checks/ --isolate",
    "validate:graph": "node scripts/check-toolchain.mjs",
    "verify:local": "bun scripts/verify-local.ts",
    "fixture": "bun scripts/fixture.ts",
    "preview:local": "bun scripts/local-worker.ts",
    "compare": "bun scripts/compare.ts",
    "compare:local": "bun scripts/compare-local.ts",
    "build:production": "node scripts/build.mjs --mode production",
    "build:pre": "node scripts/build.mjs --mode pre",
    "validate:host": "bun scripts/validate-host.ts",
    "deploy:pre": "bun scripts/deploy-pre.ts",
    "deploy:production": "bun scripts/deploy-production.ts",
    "crawl:local": "bun scripts/crawl-local.ts",
    "perf:local": "bun scripts/perf-local.ts"
  },
  "dependencies": {
    "astro": "7.4.1",
    "@astrojs/cloudflare": "15.0.0-beta.3",
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@playwright/test": "1.63.0",
    "cf": "1.0.0-beta.18",
    "miniflare": "5.20261019.1-beta",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "oxc-transform-react": "0.145.0"
  }
}
