{
  "name": "gitstarclub-web",
  "main": "src/index.ts",
  "account_id": "00f850e853e4c7f9627233d51a6e30a1",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Workers Observability is the CF dual-run log surface (P2/P3). Production
  // operators should not depend on the Vercel Workflows product UI.
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../web/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gitstarclub-web"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "gitstarclub-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "gitstarclub-jobs",
        "max_batch_size": 1,
        // 2 is enough for a real step 5xx. Do not raise this to “fix” lease
        // renew: overlapping whitelist retries were the poison path. The
        // consumer must self-reference the step (not the public 524 hop).
        "max_retries": 2
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gitstarclub-assets"
    }
  ],
  // Inheritable. A plain deploy defaults both to on and would reopen
  // gitstarclub-web.worldgo.workers.dev. env.pre sets both explicitly so a
  // preview deploy does not inherit these closed production flags.
  // CF_PREVIEW_COMMIT_SHA is not listed: pass it with --var per deploy.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "HOSTING_TARGET": "cf",
    "SITE_INDEXABLE": "1",
    "NEXT_PUBLIC_SITE_URL": "https://gitstarclub.com",
    // Production HTTP origin for cron dispatch. Preview overrides this.
    // Secrets (CRON_SECRET, REFRESH_*_URL) are platform-injected, not committed.
    "CF_CRON_ORIGIN": "https://gitstarclub.com",
    // Public read base (not a secret). Same store as env.pre. Declared here
    // so a deploy without --keep-vars cannot wipe / and /rankings.
    "BLOB_BASE_URL": "https://cdv7ejjwmzbbdj8w.public.blob.vercel-storage.com",
    "NEXT_PUBLIC_BLOB_BASE_URL": "https://cdv7ejjwmzbbdj8w.public.blob.vercel-storage.com",
    "WORKFLOW_RUNTIME": "cf-queue",
    "WORKFLOW_QUEUE_ENQUEUE_URL": "https://gitstarclub.com/enqueue",
    // Stopgap for #543: views/latest.json is missing. Serve this complete
    // version until the pointer is restored, then remove this var.
    // Do not copy it to env.pre.
    "VIEWS_VERSION_FALLBACK": "refresh-2026-09-13T06-00-16-398Z"
  },
  // Production CF Cron stays off. `triggers.crons` MUST remain []. Vercel cron
  // in web/vercel.json remains the production scheduler until Jason approves a
  // cutover. env.pre crons are paused ([]) while #543 is open; see the
  // comment there. The repo does not enable Cloudflare schedules. Enable
  // schedules / inject CRON_SECRET via an ops runbook after deploy. The top-level name
  // gitstarclub-web is production-only: GHA must never wrangler deploy it
  // except --dry-run, and repo scripts refuse a live deploy of that name.
  // Do not attach apex/www routes here.
  "triggers": {
    "crons": []
  },
  "env": {
    "pre": {
      "name": "gitstarclub-web-pre",
      // Do not inherit the closed production flags. The preview probe and
      // Access host are https://gitstarclub-web-pre.worldgo.workers.dev.
      // preview_urls matches live gitstarclub-web-pre on 2026-09-24
      // (workers.dev enabled, previews_enabled). Turning preview URLs off
      // for pre is a separate owner decision.
      // pre.gitstarclub.com/* is the staging route and is not declared here.
      "workers_dev": true,
      "preview_urls": true,
      "triggers": {
        // Preview schedules are PAUSED (owner, 2026-09-25/26; shared-store
        // incident #543). Keep this [] so a routine `wrangler deploy --env pre`
        // cannot silently re-enable them. scripts/cf-ci-gates.mjs enforces []
        // while PREVIEW_CRONS_PAUSED is true.
        // Intended expressions when the owner re-enables preview:
        //   "0 3 * * *", "0 4 * * SUN", "0 6 * * SUN"
        // Cloudflare numbers weekdays 1 = Sunday ... 7 = Saturday and rejects 0
        // (https://developers.cloudflare.com/workers/configuration/cron-triggers/).
        // Use SUN, never 7, for Sunday. To re-enable: in one PR, set these crons
        // and flip PREVIEW_CRONS_PAUSED to false in scripts/cf-ci-gates.mjs.
        // Never wrangler versions upload pre without triggers deploy.
        "crons": []
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "gitstarclub-web-pre"
        }
      ],
      // Preview queue/R2 names differ from production; must live in wrangler so
      // `wrangler deploy --env pre` / version_upload cannot drop platform bindings.
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "gitstarclub-jobs-pre"
          }
        ],
        "consumers": [
          {
            "queue": "gitstarclub-jobs-pre",
            "max_batch_size": 1,
            "max_retries": 2
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "gitstarclub-assets"
        },
        {
          "binding": "DATA",
          "bucket_name": "gitstarclub-data-pre"
        }
      ],
      "vars": {
        "HOSTING_TARGET": "cf",
        "WORKFLOW_FIXTURE": "1",
        "CF_CRON_ORIGIN": "https://pre.gitstarclub.com",
        "DEPLOY_ENV": "pre",
        // Public reads use the preview R2 domain (no storage keys). Writes use
        // the DATA binding. Production still reads Vercel Blob until I-5b.
        // R2_PREFIX is unset: the bucket root. Do not set a migrate-dev prefix.
        "STORAGE_READ_DRIVER": "r2",
        "STORAGE_WRITE_DRIVER": "r2_binding",
        "R2_BUCKET": "gitstarclub-data-pre",
        "R2_PUBLIC_BASE_URL": "https://data-pre.gitstarclub.com",
        "WORKFLOW_RUNTIME": "cf-queue",
        "WORKFLOW_QUEUE_ENQUEUE_URL": "https://pre.gitstarclub.com/enqueue",
        // D3=A (2026-09-29): preview rehearses at the production floor (10_000).
        // The 1k cold-start experiment is paused. Restoring it is an owner decision.
        "MIN_TRACKED_STARS": "10000",
        // Jason 2026-09-22: shard Search so one hop stays inside the 15 min Queue wall.
        // Unset / "0" restores the #508 single-hop path.
        "WHITELIST_SEARCH_SHARDS": "1"
      }
    }
  }
}
