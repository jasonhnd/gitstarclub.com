{
  "name": "gitstarclub-web",
  "main": "src/index.ts",
  "account_id": "00f850e853e4c7f9627233d51a6e30a1",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Workers Observability is the CF dual-run log surface (P2/P3). Production
  // operators should not depend on the Vercel Workflows product UI.
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../web/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gitstarclub-web"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "gitstarclub-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "gitstarclub-jobs",
        "max_batch_size": 1,
        "max_retries": 2
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gitstarclub-assets"
    }
  ],
  "vars": {
    "HOSTING_TARGET": "cf"
  },
  // Production CF Cron stays off. Vercel cron in web/vercel.json remains the
  // production scheduler until Jason approves a cutover. Enable crons only on
  // wrangler env `pre` (Worker gitstarclub-web-pre). The top-level name
  // gitstarclub-web is production-only: GHA must never wrangler deploy it
  // except --dry-run, and repo scripts refuse a live deploy of that name.
  // Do not attach apex/www routes here.
  "triggers": {
    "crons": []
  },
  "env": {
    "pre": {
      "name": "gitstarclub-web-pre",
      "triggers": {
        "crons": ["0 6 * * 0"]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "gitstarclub-web-pre"
        }
      ],
      "vars": {
        "HOSTING_TARGET": "cf",
        "WORKFLOW_FIXTURE": "1"
      }
    }
  }
}
