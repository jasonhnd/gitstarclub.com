{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e:screenshots": "playwright test e2e/baseline-screenshots.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:scripts": "tsc --noEmit -p ../tsconfig.scripts.json",
    "typecheck:all": "bun run typecheck && bun run typecheck:tests && bun run typecheck:scripts",
    "exports:generate": "bun scripts/generate-data-exports.ts",
    "geo:report": "bun scripts/geo-ai-log-report.ts",
    "validate:views": "bun scripts/validate-views.ts",
    "audit:deps": "bun audit --audit-level=high",
    "test": "bun test lib/",
    "test:cov": "bun test lib/ --coverage && node ../scripts/check-coverage-threshold.mjs coverage/lcov.info"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "find-up": "7.0.0",
    "minisearch": "^7.2.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "workflow": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "piscina": "4.9.3",
    "undici": "7.28.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
