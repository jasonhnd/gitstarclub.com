{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "deps:audit": "bun audit --audit-level=high",
    "exports:generate": "bun scripts/generate-data-exports.ts",
    "geo:report": "bun scripts/geo-ai-log-report.ts",
    "test": "bun test lib/",
    "test:cov": "bun test lib/ --coverage"
  },
  "dependencies": {
    "@next/third-parties": "16.2.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "find-up": "7.0.0",
    "minisearch": "^7.2.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "workflow": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "piscina": "5.2.0",
    "undici": "7.28.0"
  }
