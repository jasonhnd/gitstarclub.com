{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e:screenshots": "playwright test e2e/baseline-screenshots.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:scripts": "tsc --noEmit -p ../tsconfig.scripts.json",
    "typecheck:all": "bun run typecheck && bun run typecheck:tests && bun run typecheck:scripts",
    "exports:generate": "bun scripts/generate-data-exports.ts",
    "geo:report": "bun scripts/geo-ai-log-report.ts",
    "validate:views": "bun scripts/validate-views.ts",
    "audit:deps": "bun audit --audit-level=high",
    "test": "bun test lib/ --isolate",
    "test:cov": "bun test lib/ --coverage --isolate && node ../scripts/check-coverage-threshold.mjs coverage/lcov.info",
    "cf:build": "bun scripts/cf-opennext-build.ts",
    "cf:build:production": "bun run cf:build --site-target=production",
    "cf:build:pre": "bun run cf:build --site-target=pre",
    "cf:preview": "wrangler dev --config ../workers/gitstarclub-web/wrangler.jsonc --env pre --port 8787 --ip 127.0.0.1",
    "cf:dry-run": "bun run cf:build:pre && node ../scripts/cf-wrangler-dry-run.mjs",
    "cf:smoke": "bun scripts/cf-workers-host-smoke.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "find-up": "7.0.0",
    "minisearch": "^7.2.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.62.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "piscina": "4.9.3",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@2.1.2": "2.1.4",
    "brace-expansion@5.0.8": "5.0.9",
    "nanoid": "5.1.16"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
