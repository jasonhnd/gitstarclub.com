# GitHub API（GraphQL 批量查 star + 元数据；一个 PAT 即可）
GITHUB_TOKEN=ghp_xxx

# Vercel Blob（存放 canonical SQLite 数据文件）
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Vercel Deploy Hook（每日 cron 完成后触发重建）
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxx

# Cron 鉴权（保护 /api/cron/* 路由）
CRON_SECRET=replace-with-random-string

# 一次性回填：BigQuery（仅本地回填脚本用）
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# GCP_PROJECT_ID=your-project

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4（已配置在 Vercel：Production + Development）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
