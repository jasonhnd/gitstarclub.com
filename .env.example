# Postgres
DATABASE_URL=postgresql://user:pass@host:5432/gitstarhub

# GitHub API (用于拉 repo 元数据；MVP 阶段一个 PAT 足够)
GITHUB_TOKEN=ghp_xxx

# 可选：BigQuery 一次性回填（如果不用本地下载 GH Archive）
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# GCP_PROJECT_ID=your-project

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
