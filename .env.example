# 本地 .env 模板 —— 勿提交真实值（占位符即可）。完整说明见 docs/OPS.md §环境变量与密钥。

# GitHub API（GraphQL / Search PAT：批量查 star + 元数据 + 白名单）
# 必需（cron / Workflow）
GITHUB_TOKEN=ghp_xxx

# Vercel Blob 公开读 base URL（build / 运行时直链 fetch 视图 + 解析 publish pointer）
# 必需（读路径）；无尾斜杠 / 无 BOM
BLOB_BASE_URL=https://<store>.public.blob.vercel-storage.com

# BLOB_BASE_URL 的客户端回退（仅当 server-only 值不可用时）
# 可选（回退）；同 BLOB_BASE_URL
NEXT_PUBLIC_BLOB_BASE_URL=https://<store>.public.blob.vercel-storage.com

# Vercel Blob 读写令牌（存放 canonical Parquet / JSON shard + 版本化视图）
# 必需（写路径：cron 写活尾 · Workflow 写 canonical/views）
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Cron 鉴权随机串（保护 /api/cron/* 与 Workflow 触发；Vercel 注入 Authorization: Bearer <secret>）
# 必需（cron / Workflow 鉴权）；≥32 字符、无首尾空白
CRON_SECRET=replace-with-random-string

# 失败告警 webhook（数据 pipeline 失败时 POST JSON 摘要；不设则仅日志）
# 可选；Slack / Discord incoming webhook 或 https://webhook.site/...
# ALERT_WEBHOOK_URL=https://example.com/webhook

# 生产 indexing 开关——"1" 解除 pre-launch noindex 并开放 sitemap
# 上线 flag（未设 / 其他值 = noindex）
# SITE_INDEXABLE=1

# Vercel Deploy Hook URL（手动 / CI 触发一次核心 rebuild；非每日触发）
# 可选——ISR 模型下数据更新不需要 deploy（每日 cron 只 revalidatePath，不重建）
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxx

# 一次性回填：BigQuery（仅本地回填脚本用）
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# GCP_PROJECT_ID=your-project

# Next.js 站点规范域名（canonical / sitemap / OG / JSON-LD 绝对 URL）
# 必需（生产）；无尾斜杠
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4（已配置在 Vercel：Production + Development）
# 可选
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
