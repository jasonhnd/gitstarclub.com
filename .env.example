# Local .env template — do not commit real values (placeholders are enough). Full notes: docs/OPS.md §Environment variables and secrets.

# GitHub API (GraphQL / Search PAT: batch star lookup + metadata + whitelist)
# Required (cron / Workflow)
GITHUB_TOKEN=ghp_xxx

# Vercel Blob public-read base URL (build / runtime fetch views directly and resolve the publish pointer)
# Optional legacy tools or local fixture only; host modes supply their R2 origin.
# BLOB_BASE_URL=http://127.0.0.1:4010

# Client fallback for BLOB_BASE_URL (only when the server-only value is unavailable)
# Optional (fallback); same as BLOB_BASE_URL
# NEXT_PUBLIC_BLOB_BASE_URL=http://127.0.0.1:4010

# Vercel Blob read-write token (stores canonical Parquet / JSON shards + versioned views)
# Optional legacy tooling; Workers write through DATA.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Cloudflare R2. Typed production/pre modes supply the public read origin and DATA binding.
# Production cutover was accepted 2026-10-04; see docs/R2-CUTOVER.md.
# STORAGE_READ_DRIVER=r2
# STORAGE_WRITE_DRIVER=r2_binding
# READ_DRIVER=r2
# WRITE_DRIVER=r2_binding
# R2_ACCOUNT_ID=00f850e853e4c7f9627233d51a6e30a1
# R2_S3_ENDPOINT=https://00f850e853e4c7f9627233d51a6e30a1.r2.cloudflarestorage.com
# AWS_ENDPOINT_URL=https://00f850e853e4c7f9627233d51a6e30a1.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# AWS_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# AWS_SECRET_ACCESS_KEY=
# Preview DATA is gitstarclub-data-pre; production DATA is gitstarclub-data-prod.
# MEDIA stays gitstarclub-assets.
# R2_BUCKET=gitstarclub-data-pre
# AWS_S3_BUCKET=gitstarclub-data-pre
# R2_REGION=auto
# AWS_REGION=auto
# Optional object key prefix. Blank is the bucket root. Not a write allowlist.
# R2_PREFIX=
# Deployment identity. R2 writes need production or pre, matching the bucket marker.
# Cloudflare Workers must set this; they do not receive VERCEL_ENV. See docs/VINEXT-HOST.md.
# DEPLOY_ENV=pre
# R2_PUBLIC_BASE_URL=https://data-pre.gitstarclub.com

# Random string for cron auth (protects /api/cron/* and refresh start/step; Vercel sends Authorization: Bearer <secret>)
# Required (cron / refresh auth); ≥32 characters, no leading or trailing whitespace
CRON_SECRET=replace-with-random-string

# Managed refresh runtime (P1; default http). cf-queue is non-production only.
# WORKFLOW_RUNTIME=http
# WORKFLOW_QUEUE_ENQUEUE_URL=https://gitstarclub-web-pre.example/enqueue
# WORKFLOW_STEP_BASE_URL=https://pre.gitstarclub.com

# Cloudflare migrate P2 (default remains Vercel; see docs/CF-MIGRATION-P2.md)
# CACHE_INVALIDATION_DRIVER=vercel
# CF_CACHE_PURGE_URL=https://gitstarclub-web-pre.worldgo.workers.dev/preview/invalidate
# PREVIEW_TARGET=vercel
# CF_PREVIEW_ORIGIN=https://gitstarclub-web-pre.worldgo.workers.dev
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# CF_PREVIEW_REQUIRE_SHA=0
# CF_PREVIEW_COMMIT_SHA=

# Tracked-universe floor (GitHub Search stars:>=N). Default 10000.
# Preview typed mode pre matches production (10000). The 1k experiment is paused.
# MIN_TRACKED_STARS=10000

# Typed vinext host modes set HOSTING_TARGET=cf automatically.
# No deployment is authorized by local configuration.
# CF_WORKERS_HOST_ORIGIN=http://127.0.0.1:4176
# CF_WORKERS_HOST_LOCAL=1

# Failure alert webhook (POST a JSON summary when the data pipeline fails; logs only if unset)
# Optional; Slack / Discord incoming webhook or https://webhook.site/...
# ALERT_WEBHOOK_URL=https://example.com/webhook

# Production indexing switch — "1" lifts the pre-launch noindex and opens the sitemap
# Launch flag (unset / any other value = noindex)
# SITE_INDEXABLE=1

# Vercel Deploy Hook URL (manual / CI trigger of one core rebuild; not a daily trigger)
# Optional — under the ISR model a data update does not need a deploy (the daily cron only revalidatePath, it does not rebuild)
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxx

# Historical BigQuery backfill: retired 2026-10-19; do not provision credentials
# Raw archive is private R2 gitstarclub-raw; see docs/OPS.md#raw-backfill-data
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# GCP_PROJECT_ID=your-project

# Next.js site canonical origin (absolute URLs for canonical / sitemap / OG / JSON-LD)
# Required (production); no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
